{
  "expo": {
    "name": "Langtify",
    "slug": "langtify",
    "version": "0.1.0",
    "icon": "./assets/branding/icon.png",
    "scheme": "langtify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/icon.png",
      "bundleIdentifier": "com.langtify.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F4",
        "foregroundImage": "./assets/branding/foreground-light.png",
        "monochromeImage": "./assets/branding/monochrome.png"
      },
      "package": "com.langtify.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F4",
          "image": "./assets/branding/wordmark-light.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#111D21",
            "image": "./assets/branding/wordmark-dark.png"
          },
          "resizeMode": "contain",
          "android": {
            "image": "./assets/branding/foreground-light.png",
            "imageWidth": 288,
            "dark": {
              "image": "./assets/branding/foreground-dark.png",
              "backgroundColor": "#111D21"
            }
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Use your camera to capture the words you’re learning.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your words and profile.",
          "cameraPermission": "Use your camera to capture the words you’re learning.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "learning"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": ["ios", "android", "web"]
  }
}

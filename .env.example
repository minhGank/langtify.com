# Copy to .env.local and fill from your Supabase project's Connect dialog.
# ANON_KEY accepts a public sb_publishable_... key or legacy anon JWT.
# All EXPO_PUBLIC_* values are shipped in the app. Never use service_role/secret keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public EAS project UUID for physical-device push registration (not a secret).
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional build-only path to Android Firebase client google-services.json.
# This is NOT an FCM service-account key; keep provider secrets in trusted services.
LANGTIFY_GOOGLE_SERVICES_FILE=

# Hosted Langtify Dev signup OTP contract: six digits. Not a secret/Auth policy.
# Must match the hosted Confirm signup template/code setting; this value does not
# configure Supabase. See docs/QA25_AUTH_EMAIL_CODES.md.
EXPO_PUBLIC_SIGNUP_CODE_LENGTH=6
